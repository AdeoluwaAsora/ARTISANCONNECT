# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# ---------- Postgres ----------
POSTGRES_DB=artisanconnect
POSTGRES_USER=artisanconnect_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------- Redis ----------
REDIS_PASSWORD=change-me-to-a-strong-password

# ---------- JWT ----------
# Must be at least 32 characters (256 bits) - HMAC-SHA256 signing keys
# shorter than this are a real, exploitable weakness, not just a lint rule.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ISSUER=ArtisanConnect.API
JWT_AUDIENCE=ArtisanConnect.Clients

# ---------- CORS ----------
CORS_ALLOWED_ORIGIN_1=http://localhost:3000

# ---------- ASP.NET Core ----------
ASPNETCORE_ENVIRONMENT=Production
